# Optional. Next.js reads this file when the dev server starts, so restart it after editing.
# Copy to frontend/.env.local. The values below match the Docker Compose setup.

# Must be reachable from the browser, not from inside a container.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: prefill the "Viewing user" box with a creator ID from your own database.
# NEXT_PUBLIC_DEFAULT_USER_ID=
