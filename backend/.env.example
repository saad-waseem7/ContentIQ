# Optional. Only needed when you run the API outside Docker, or want a backend-local override.
# With Docker Compose, put everything in the repository root .env instead (see docs/setup.md).
# Copy to backend/.env and replace every value that does not suit your setup.

# Host "localhost" and the published POSTGRES_PORT work from your own shell.
# Inside the Docker network use host "db" and port 5432.
DATABASE_URL=postgresql://contentiq:changeme_local_dev@localhost:5432/contentiq
POSTGRES_USER=contentiq
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_DB=contentiq
MLFLOW_TRACKING_URI=http://localhost:5001

# mock (default) or gemini. Any other value makes the API refuse to start.
LLM_PROVIDER=mock

# Needed only when LLM_PROVIDER=gemini. Set GEMINI_MODEL to a model your key can call.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_SEC=30
